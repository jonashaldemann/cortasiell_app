rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tage/{tagId} {
      allow read: if true;
      allow write: if tagId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['personen', 'aktivitaet'])
        && request.resource.data.get('personen', []) is list
        && request.resource.data.get('personen', []).size() <= 20
        && request.resource.data.get('aktivitaet', '') is string
        && request.resource.data.get('aktivitaet', '').size() <= 500;
    }

    match /projekte/{projektId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
          ['titel', 'beschreibung', 'verantwortlich', 'anzahlPersonen', 'dauerTage', 'checkliste',
           'kosten', 'status', 'reihenfolge', 'dateiUrl', 'dateiId', 'dateiName', 'erstelltAm',
           'startDatum', 'endDatum', 'geloescht', 'verschiebeStart', 'verschiebeEnde'])
        && request.resource.data.titel is string
        && request.resource.data.titel.size() <= 200
        && request.resource.data.reihenfolge is number
        && request.resource.data.get('checkliste', []) is list;
    }

    match /ereignisse/{ereignisId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
          ['titel', 'vonDatum', 'bisDatum', 'projektId', 'erstelltAm', 'verschiebeVon', 'verschiebeBis'])
        && request.resource.data.titel is string
        && request.resource.data.titel.size() <= 200
        && request.resource.data.vonDatum.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.bisDatum.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.get('verschiebeVon', '2000-01-01').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.get('verschiebeBis', '2000-01-01').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    match /konfiguration/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['optionen'])
        && request.resource.data.optionen is list;
    }

    match /einkaufsliste/{itemId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
          ['text', 'erledigt', 'reihenfolge', 'angepinnterName', 'link'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200
        && request.resource.data.reihenfolge is number
        && request.resource.data.get('link', '') is string
        && request.resource.data.get('link', '').size() <= 500;
    }

    match /menuplan/{tagId} {
      allow read: if true;
      allow write: if tagId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['kuechenchef', 'zmorge', 'zmittag', 'znacht'])
        && request.resource.data.get('kuechenchef', '') is string
        && request.resource.data.get('zmorge', '') is string
        && request.resource.data.get('zmittag', '') is string
        && request.resource.data.get('znacht', '') is string;
    }

    match /adressen/{adressId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
          ['bezeichnung', 'name', 'vorname', 'ort', 'tel', 'mail', 'webseite', 'erstelltAm'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200;
    }

    match /notizen/{notizId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['text', 'name', 'erstelltAm', 'geloescht'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 100;
    }
  }
}
